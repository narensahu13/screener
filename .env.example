# Data source: mock | angelone | upstox
# Recommended live path: angelone (needs Oracle Always Free static IP for SmartAPI app)
DATA_SOURCE=mock

# --- Angel One SmartAPI (primary live) ---
# Create app at https://smartapi.angelone.in/ — static IP required for all app types.
# Login is daily (session until ~midnight IST): client code + PIN + TOTP.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
# Optional overrides
# ANGEL_MAC_ADDRESS=00:00:00:00:00:01
# ANGEL_REST_BASE=https://apiconnect.angelone.in
# ANGEL_WS_URL=wss://smartapisocket.angelone.in/smart-stream

# --- Upstox (optional adapter) ---
# Analytics Token (1-year) — no daily login; market data without static IP
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Paths (optional overrides)
UNIVERSE_PATH=data/universe.csv
HISTORICAL_DATA_DIR=data/historical

# Scan schedule (IST)
SCAN_START_TIME=09:17:05
SCAN_END_TIME=15:30:00
TIMEZONE=Asia/Kolkata

# Mock feed
MOCK_SPEED=60
MOCK_SYMBOL_LIMIT=40
HISTORY_LOOKBACK_DAYS=5

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
