# Data source: mock | upstox
DATA_SOURCE=mock

# Upstox Analytics Token (1-year) — required when DATA_SOURCE=upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Paths (optional overrides)
UNIVERSE_PATH=data/universe.csv
HISTORICAL_DATA_DIR=data/historical

# Scan schedule (IST)
SCAN_START_TIME=09:17:05
SCAN_END_TIME=15:30:00
TIMEZONE=Asia/Kolkata

# Mock feed
MOCK_SPEED=60
MOCK_SYMBOL_LIMIT=40
HISTORY_LOOKBACK_DAYS=5

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
